# Downloaded reports – do not commit raw source files (STR exports, Datafy PDFs, GA4 exports)
downloads/

# Raw STR Excel exports (large binaries, contain market data — committed DB is the source of truth)
data/str/*.xlsx
data/str/*.xls

# Logs
logs/*.png
# CoStar fetch step screenshots: debugging output that can show the portal
# account and licensed CoStar screens, never committed to this public repo.
logs/costar_fetch_screens/
logs/*.log
logs/*.json

# Python
__pycache__/
*.pyc
.env
.env.save
venv/
# .streamlit/secrets.toml is gitignored — config.toml is committed intentionally
.streamlit/secrets.toml

# Database — analytics.sqlite is committed intentionally (STR market data, no PII)
# Raw/temp DBs excluded
*.db
# Junk SQLite URI artifact (0-byte file created by sqlite3 URI bug)
data/analytics.sqlite?*

# Notes/annotation DB and the PDF report archive — user-generated content,
# not source data, and not persistent across a Railway redeploy unless
# NOTES_DB_PATH / REPORT_ARCHIVE_DIR point at a mounted Volume. Never commit.
data/dashboard_notes.sqlite
data/report_archive/

# Claude Code internals
.claude/worktrees/

# macOS metadata
.DS_Store
**/.DS_Store
logs/*.pdf
logs/*.html

# Transient FUSE lock artifacts and this session's scratch/trash folder -- never real
# project data, sometimes swept in by an unrelated automated commit.
_to_delete/
data/.fuse_hidden*

# Weekly Heather recaps (PDFs, drafts, addresses): local only, never in this public repo
recaps/*
!recaps/templates/
_to_delete_local/
